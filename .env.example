# ─── Asosiy bot (bemorlar uchun) ───
BOT_TOKEN=123456:XXXX
# Bot ichida ariza tugmalarini boshqaradigan adminlar (ixtiyoriy)
ADMIN_IDS=

# ─── Hisobot boti (@ai_humoyunbot) ───
# Arizalar va kunlik xulosalar shu bot orqali yuboriladi.
# Uning webhook'iga tegilmaydi — faqat sendMessage ishlatiladi.
REPORT_BOT_TOKEN=
REPORT_CHAT_IDS=

# ─── Web ───
# Deploy qilingandan keyin Render bergan manzil, masalan https://urolog-bot.onrender.com
BASE_URL=http://localhost:8000
WEBHOOK_SECRET=change-me-random-string
PORT=8000

# ─── Ma'lumotlar bazasi ───
# Bo'sh bo'lsa lokal SQLite ishlatiladi.
# Neon: postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ─── AI-konsultant («Jonli murojaat») ───
# ASK_ENABLED  — bo'lim menyuda va Mini App'da ko'rinadimi
# AI_ENABLED   — AI javob beradimi (false bo'lsa bo'lim «tayyorlanmoqda» deydi)
# AI_API_KEY   — Google AI Studio kaliti: https://aistudio.google.com
ASK_ENABLED=true
AI_ENABLED=true
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
