# ─── Asosiy bot (bemorlar uchun) ───
BOT_TOKEN=123456:XXXX
# Bot ichida ariza tugmalarini boshqaradigan adminlar (ixtiyoriy)
ADMIN_IDS=

# ─── AI operator boti (@ai_humoyunbot) ───
# Arizalar, kunlik xulosalar va «boshqa admin kerak» signallari shu bot
# orqali yuboriladi. Undan turib AI ni to'xtatib ham qo'yish mumkin:
#   404 — AI ni darhol to'xtatish (Telegram + Instagram)
#   101 — qayta ishga tushirish
#   holat — hozirgi holatni ko'rish
# Buyruqlarni faqat ADMIN_IDS va REPORT_CHAT_IDS dagi odamlar bera oladi.
# Bot webhook'i shu servisga ulanadi (`/webhook/op/<WEBHOOK_SECRET>`).
REPORT_BOT_TOKEN=
REPORT_CHAT_IDS=

# ─── Web ───
# Deploy qilingandan keyin Render bergan manzil, masalan https://urolog-bot.onrender.com
BASE_URL=http://localhost:8000
WEBHOOK_SECRET=change-me-random-string
PORT=8000

# ─── Ma'lumotlar bazasi ───
# Bo'sh bo'lsa lokal SQLite ishlatiladi.
# Neon: postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ─── AI-konsultant («Jonli murojaat») ───
# ASK_ENABLED  — bo'lim menyuda va Mini App'da ko'rinadimi
# AI_ENABLED   — AI javob beradimi (false bo'lsa bo'lim «tayyorlanmoqda» deydi)
# AI_API_KEY   — Google AI Studio kaliti: https://aistudio.google.com
ASK_ENABLED=true
AI_ENABLED=true
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite

# ─── Jonli operator guruhi ───
# Har bemorning suhbati shu guruhda alohida mavzuda (topic) jonli ko'chib
# boradi; admin o'sha mavzuga yozsa javob bemorga ketadi.
#
# Sozlash tartibi:
#   1. Telegramda yangi guruh oching;
#   2. Guruh sozlamalari → «Mavzular» (Topics) ni YOQING;
#   3. Botni guruhga qo'shing va ADMIN qiling
#      («Mavzularni boshqarish» huquqi shart);
#   4. BotFather → /setprivacy → bu bot → Disable
#      (aks holda bot guruhdagi oddiy matnni ko'rmaydi);
#   5. Guruhda /id yozing va chiqqan «Guruh ID» ni shu yerga qo'ying.
#
# Bo'sh qoldirilsa guruh o'chiq bo'ladi va bot avvalgidek ishlaydi.
SUPPORT_GROUP_ID=

# Odam suhbatga aralashgach AI qancha vaqt jim turadi (daqiqa).
# Shifokorning qarori: 60. Undan keyin AI odam yozganlarini o'qib davom etadi.
HUMAN_PAUSE_MINUTES=60

# Boshqa adminga signal ketgach AI qancha javob kutadi (daqiqa).
# Shu vaqt ichida admin «Javob beraman» yoki «AI davom ettirsin» tugmasini
# bosishi kutiladi. Bosilmasa bemorga xabar berilib, AI davom etadi.
WAIT_MINUTES=30

# ─── Instagram tizimi bilan ko'prik ───
# Instagram tomonini n8n yuritadi va u BOSHQA bazada yashaydi. Signalni
# esa shu servis yuboradi — xabar ko'rinishi va tugmalari ikkala kanalda
# bir xil bo'lsin. Ulanish satri: n8n servisining `DB_POSTGRESDB_*`
# env laridan yig'iladi (postgresql://user:pass@host:port/db).
#
# Bo'sh qoldirilsa Instagram tomoni umuman qo'shilmaydi va bot
# avvalgidek ishlaydi.
#
# ⚠️ Bu env qo'yilganda n8n dagi `OWNER_TELEGRAM_CHAT_ID` ni BO'SHATING —
# aks holda bitta hodisa uchun ikkita xabar keladi.
IG_DATABASE_URL=
